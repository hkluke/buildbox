#cloud-config
package_update: true
package_upgrade: true
# A kernel from the upgrade only runs after a reboot, and a local root hole
# on the box is the agent user's. Ubuntu raises /run/reboot-required when a
# package needs one; the reboot lands here, before runcmd, so the box joins
# the tailnet on its final kernel. /run is empty again on the second boot.
package_reboot_if_required: true
# Hetzner's datasource refreshes the network config on every boot over the
# interface name it saw first, which netplan renames, so a second boot waits
# 30 s for a lease and fails. Nothing changes a box's network after it exists.
updates:
  network:
    when: [boot-new-instance]
packages:
  - git
  - keychain
  - btop
  - tailscale
  # What the agent cannot install without sudo: a C toolchain, which Rust,
  # cgo, native modules, and source builds need, pkg-config, the half of
  # venv Ubuntu leaves out, and unzip for installers that insist on it.
  - build-essential
  - pkg-config
  - python3-venv
  - unzip

  # Rootless Docker for the agent user. slirp4netns gives it networking on
  # x86 and ARM alike; dbus-user-session lets it apply cgroup limits.
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - docker-buildx-plugin
  - docker-compose-plugin
  - docker-ce-rootless-extras
  - uidmap
  - slirp4netns
  - dbus-user-session

# Docker's own repo ships the rootless extras and current releases, and
# Ubuntu's archive has no Tailscale package. Each key is pinned by
# fingerprint, fetched from the keyserver at boot, and trusted only for
# its repo.
apt:
  sources:
    docker:
      source: "deb [signed-by=$KEY_FILE] https://download.docker.com/linux/ubuntu $RELEASE stable"
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88
    tailscale:
      source: "deb [signed-by=$KEY_FILE] https://pkgs.tailscale.com/stable/ubuntu $RELEASE main"
      keyid: 2596A99EAAB33821893C0A79458CA832957F5868

# Hetzner's vendor-data sets a root password, allows root and password SSH
# login, and uses chpasswd syntax that makes cloud-init exit with warnings.
# None of it is wanted here, and without it any warning is a real problem.
vendor_data:
  enabled: false

# Hetzner turns on password login when no SSH key is passed to hcloud.
# OpenSSH is removed below; this keeps passwords off should it ever return.
ssh_pwauth: false

# No authorized_keys: logins arrive over Tailscale SSH, which the tailnet
# policy decides by the connecting device's identity. Nothing on the box
# can log in to another user, because there is no key to do it with.
users:
  - name: admin
    groups: sudo
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash

  - name: agent
    groups: users
    shell: /bin/bash

# write-files runs before users-groups, so this cannot target the home
# directory. runcmd appends it after the skel .bashrc exists. DOCKER_HOST is
# for tools that ignore the docker CLI context, such as Docker SDKs. keychain
# is quiet so that a login shows the welcome below and not four lines about
# the agent it found; it still asks for a passphrase and still warns.
write_files:
  - path: /var/lib/buildbox/agent.bashrc
    permissions: "0644"
    content: |
      eval $(keychain --quiet --eval --agents ssh git_key)
      export DOCKER_HOST=unix:///run/user/$(id -u)/docker.sock
  # Disabling OpenSSH's units does not keep it off. cloud-init's network
  # unit wants sshd.service, so every boot starts it again, and systemd 256
  # and later give an installed sshd a unix socket any local user can open.
  # These two empty files are the switches for both: Ubuntu's ssh units skip
  # sshd while the first exists, and the second masks the generator that
  # makes the socket. They also hold when a later package brings
  # openssh-server back as a dependency.
  - path: /etc/ssh/sshd_not_to_be_run
    permissions: "0644"
    content: ""
  - path: /etc/systemd/system-generators/systemd-ssh-generator
    permissions: "0644"
    content: ""
  # The agent user's welcome at login: the wordmark and what the box holds.
  # Every login shell reads the first file, which runs the second for an
  # interactive login of that user alone, so a command, scp, and rsync get
  # no word of it. Both are ASCII: the script spells its block characters in
  # octal.
  - path: /etc/profile.d/buildbox-welcome.sh
    permissions: "0644"
    content: |
      # buildbox's welcome for the agent user, at an interactive login and
      # nowhere else. A command, scp, and rsync run through a login shell too, and
      # a word printed there would end up in their output. tmux and screen start a
      # login shell in every pane.
      case $- in
        *i*)
          if [ "$(id -un)" = agent ] && [ -z "${TMUX:-}${STY:-}" ] && [ -t 1 ]; then
            /usr/local/lib/buildbox/welcome
          fi
          ;;
      esac
  - path: /usr/local/lib/buildbox/welcome
    permissions: "0755"
    content: |
      #!/bin/bash
      # What the agent user sees at an interactive login, in place of Ubuntu's
      # own welcome, which ~/.hushlogin keeps quiet. The Box row is read at each
      # login; everything else was fixed when buildbox created this box.

      escape=$'\033'
      # Octal, so that the cloud-init document that carries this file stays ASCII:
      # the upper half block, the lower half block, the full block, and the middle
      # dot.
      upper=$'\342\226\200' lower=$'\342\226\204' full=$'\342\226\210' dot=$'\302\267'

      # Nothing on the box can ask the terminal which colors it has: TERM reads
      # xterm-256color on nearly every one, with 24-bit color or without, and SSH
      # does not pass COLORTERM on unless told to. Nearly every terminal has 24-bit
      # color, so only one that says it has no color at all gets none.
      if [ -n "${NO_COLOR:-}" ] || [ "${TERM:-dumb}" = dumb ]; then
        color='' dim='' bold='' code='' plain=''
      else
        color=yes dim="${escape}[2m" bold="${escape}[1m" code="${escape}[33m" plain="${escape}[0m"
      fi

      # shade sets ink to the color of one pixel, at paint's column: # is the
      # wordmark, which runs from teal (#2BB8A0) on the left to mint (#B4ECDF) on
      # the right as the wizard's does, : is its shadow, and anything else is the
      # terminal's own background. Without color the shadow goes, since it would
      # only thicken the letters.
      shade() {
        case $1 in
          '#')
            ink="38;2;$((43 + (137 * column + span / 2) / span))"
            ink+=";$((184 + (52 * column + span / 2) / span))"
            ink+=";$((160 + (63 * column + span / 2) / span))"
            ;;
          ':') ink=${color:+38;2;23;87;79} ;;
          *) ink='' ;;
        esac
      }

      # paint draws the picture on its input. A line of text holds two rows of
      # pixels, one in the upper half of each cell and one in the lower, so the
      # pixels come out square.
      paint() {
        local above below line span column ink over under block colors

        while IFS= read -r above && IFS= read -r below; do
          span=$((${#above} - 1)) line=''

          for ((column = 0; column <= span; column++)); do
            shade "${above:column:1}"
            over=$ink
            shade "${below:column:1}"
            under=$ink

            case ${over:+o}${under:+u} in
              o) block=$upper colors=$over ;;
              u) block=$lower colors=$under ;;
              ou)
                if [ "$over" = "$under" ]; then
                  block=$full colors=$over
                else
                  block=$upper colors="$over;${under/#38/48}"
                fi
                ;;
              *)
                line+=' '
                continue
                ;;
            esac

            line+="${color:+${escape}[${colors}m}$block$plain"
          done

          # Without its shadow the picture's last line is empty.
          line=${line%"${line##*[! ]}"}
          if [ -n "$line" ]; then
            printf '  %s\n' "$line"
          fi
        done
      }

      row() {
        printf '  %s%-11s%s%s\n' "$dim" "$1" "$plain" "$2"
      }

      # The wide picture is 79 columns with its margin and the narrow one 35. A
      # session that came without a window size says 0 and gets the wide one.
      columns=$(stty size 2>/dev/null) columns=${columns#* }

      if [ "${columns:-0}" -eq 0 ] || [ "$columns" -ge 80 ]; then
        echo
        paint <<'PICTURE'
      .........................................................................##.#
      .........................................................................##..
      ##......................##........##..##..............................##.....
      ##:.................##..##:.......##:.##:.............................##....#
      ##:.................##:.##:.......##:.##:..........................##........
      ##:..................::.##:.......##:.##:..........................##.....#..
      #######...##....##..##..##:..#######:.#######....######...###..........##....
      ########..##:...##:.##:.##:.########:.########..########...###..##.....##....
      ##::::##:.##:...##:.##:.##:.##::::##:.##::::##:.##::::##:...######:..........
      ##:...##:.##:...##:.##:.##:.##:...##:.##:...##:.##:...##:....####::..........
      ##:...##:.##:...##:.##:.##:.##:...##:.##:...##:.##:...##:....####:...........
      ##:...##:.##:...##:.##:.##:.##:...##:.##:...##:.##:...##:...######...........
      ########:.########:.##:.##:.########:.########:.########:..###::###..........
      #######::..#######:.##:.##:..#######:.#######::..######::.###::..###.........
      .:::::::....:::::::..::..::...:::::::..:::::::....::::::...:::....:::........
      .............................................................................
      PICTURE
      elif [ "$columns" -ge 36 ]; then
        echo
        paint <<'PICTURE'
      #.........#.#....#.#.............
      #...........#....#.#.............
      ####.#..#.#.#.####.####.####.#..#
      #..#.#..#.#.#.#..#.#..#.#..#..##.
      #..#.#..#.#.#.#..#.#..#.#..#..##.
      ####.####.#.#.####.####.####.#..#
      PICTURE
      fi

      printf '\n  %s\n\n' "${dim}Let your agent think inside the box.$plain"

      box="$bold$(hostname)$plain $dot $(. /etc/os-release && printf '%s' "$PRETTY_NAME")"

      cores="$(nproc) cores"
      box+=" $dot ${cores/#1 cores/1 core}"

      # Installed memory is the size the box was rented with. MemTotal is what the
      # kernel left of it, which rounds to another number on a large box.
      memory=$(lsmem --bytes --summary=only 2>/dev/null | sed --quiet 's/^Total online memory: *//p')
      if [ -n "$memory" ]; then
        box+=" $dot $(((memory + (1 << 29)) >> 30)) GB"
      fi

      free=$(df --output=avail --block-size=G /)
      box+=" $dot ${free//[!0-9]/} GB free"

      row Box "$box"
      row Projects '~/projects'

      tools="${code}agy$plain"
      if [ -n "$tools" ]; then
        row Tools "$tools"
      fi

      row Docker 'rootless, as agent'
      row Sudo "admin has it: ${code}ssh admin@build-x$plain"

      # Ubuntu raises this flag when an update, a new kernel for one, takes effect
      # only after a restart. It is the one line of Ubuntu's welcome that is kept.
      if [ -e /run/reboot-required ]; then
        row Restart "needed by an update: ${code}ssh admin@build-x sudo reboot$plain"
      fi

      echo
  # Antigravity CLI builds its sandbox from user namespaces and offers Auto
  # mode only with it. Ubuntu denies working user namespaces to a program
  # without an AppArmor profile that allows them. This profile confines
  # nothing and allows only that, the shape Ubuntu ships for rootlesskit.
  # agy sits in the agent's home, so in effect the agent user gets them,
  # which rootlesskit already gives it. runcmd loads the profile.
  - path: /etc/apparmor.d/agy
    permissions: "0644"
    content: |
      abi <abi/5.0>,
      include <tunables/global>

      profile agy /home/agent/.local/bin/agy flags=(unconfined) {
        userns,
        @{exec_path} mr,
      }

runcmd:
  # Without --ssh-key, Hetzner sets a root password and prints/emails it.
  # Locking it makes those copies useless without asking for a Hetzner key.
  - ['passwd', '--lock', 'root']
  # Tailscale SSH is the only way in, so the box carries no OpenSSH server
  # for the agent user to reach on loopback. Remove, not purge: Tailscale SSH
  # presents the host keys in /etc/ssh, and a purge deletes them. Tailscale
  # serves SFTP itself, so OpenSSH's sftp-server goes too. Like every package
  # step, this comes before the tailnet join.
  - ['env', 'DEBIAN_FRONTEND=noninteractive', 'apt-get', '--option', 'DPkg::Lock::Timeout=300',
     'remove', '--yes', 'openssh-server', 'openssh-sftp-server']
  # systemd makes sshd's unix socket at the start of the first boot, before
  # the mask above exists. This stops what is left of it, so nothing
  # lingers on a box that did not reboot. A pattern and not the name: it
  # matches nothing where there is no such socket, which is no error.
  - ['systemctl', 'stop', 'sshd-*.socket']
  # Tailscale. Its package starts tailscaled, so up needs no service step.
  # The tag makes the box the tag's device rather than the user's, so no rule
  # about the user's devices applies to it; a key without the tag is refused
  # here. Auto-update keeps a long-lived box on a current client.
  - ['tailscale', 'up', '--auth-key=tskey-auth-SAMPLE', '--ssh', '--advertise-tags=tag:buildbox', '--hostname=build-x']
  - ['tailscale', 'set', '--auto-update']
  # Host-level lockdown
  - ['ufw', 'default', 'deny', 'incoming']
  - ['ufw', 'default', 'allow', 'outgoing']
  - ['ufw', 'allow', 'in', 'on', 'tailscale0']
  - ['ufw', '--force', 'enable']
  # Projects directory for agent
  - ['mkdir', '-p', '/home/agent/projects']
  - ['chown', 'agent:agent', '/home/agent/projects']
  - ['sh', '-c', 'cat /var/lib/buildbox/agent.bashrc >> /home/agent/.bashrc']
  - ['chown', 'agent:agent', '/home/agent/.bashrc']
  # Ubuntu greets a login with some thirty lines of links, load figures, and
  # notices. This file keeps them from the agent user, whose welcome is the
  # one written above. admin, who looks after the system, still gets them.
  - ['runuser', '--user', 'agent', '--', 'touch', '/home/agent/.hushlogin']
  # Rootless Docker for the agent user. The packages start a root daemon;
  # stop it so the only Docker on the box runs as the agent user.
  - ['systemctl', 'disable', '--now', 'docker.service', 'docker.socket', 'containerd.service']
  - ['rm', '-f', '/var/run/docker.sock']
  # Linger keeps the agent's user manager, and its Docker daemon, running
  # without a login. The setup tool needs that manager to be up.
  - ['loginctl', 'enable-linger', 'agent']
  - ['sh', '-c', 'systemctl start user@$(id -u agent).service']
  - ['runuser', '-l', 'agent', '-c', 'XDG_RUNTIME_DIR=/run/user/$(id -u) dockerd-rootless-setuptool.sh install']
  # agy's AppArmor profile, before agy first runs. AppArmor reads
  # /etc/apparmor.d only at boot, so a box that did not reboot would not have
  # it. Replace, not add: a box that did reboot has it loaded already.
  - ['apparmor_parser', '--replace', '/etc/apparmor.d/agy']
  # Antigravity CLI for the agent user
  - ['su', '-', 'agent', '-c', 'curl -fsSL https://antigravity.google/cli/install.sh | bash']
